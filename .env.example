# Setup guide: docs/environment.md
# Optional doctl context matching your Control Panel team (doctl auth list).
DOCTL_CONTEXT=
# Setup only: replace these before creating either trigger.
GITHUB_REPOSITORY=your-owner/your-demo-repo
DEFAULT_BRANCH=main
GITHUB_ACTOR=your-github-actor
HARNESS_INFERENCE_API_KEY=
SLACK_WEBHOOK_URL=

# Relay: use a NEW secret here, distinct from the DO trigger secret.
GITHUB_WEBHOOK_SECRET=
AGENT_LABEL=agent
# Fine-grained PAT: selected repo, Metadata read. Used only for labeler lookup.
# Classic PAT/OAuth alternative: repo and read:org, with repository push access.
RELAY_GITHUB_TOKEN=
# From the custom trigger's one-time response (not the direct GitHub trigger).
HARNESS_TRIGGER_URL=
HARNESS_TRIGGER_SECRET=
# Local SQLite fallback only. DATABASE_URL takes precedence when set.
DATABASE_PATH=./data/relay.sqlite3
# App Platform binds this to ${relay-db.DATABASE_URL}; never commit its value.
DATABASE_URL=
# Set by deploy/app.yaml; requires PostgreSQL to prevent ephemeral SQLite use.
# APP_PLATFORM=true
